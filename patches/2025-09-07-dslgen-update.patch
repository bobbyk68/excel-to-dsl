+        <button type="submit" class="btn btn-success w-100">Add Rule</button>
+      </form>
+    </div>
+
+    <div class="card mt-4 p-4 shadow-sm">
+      <h3 class="mb-3 text-primary">Existing Rules</h3>
+      <table class="table table-bordered table-striped" id="rulesTable">
