+      if (!res.ok) return;
+      const rules = await res.json();
+      rulesTable.innerHTML = '';
+      rules.forEach((r) => {
+        rulesTable.innerHTML += `<tr>
+          <td>${r.patternType}</td>
+          <td>${r.lhs}</td>
+          <td>${r.rhs}</td>
+          <td><button class="btn btn-sm btn-outline-primary" onclick="editRuleById('${r.id}')">Edit</button></td>
+        </tr>`;
+      });
