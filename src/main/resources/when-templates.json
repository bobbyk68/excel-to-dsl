[
  {
    "id": "DOC",
    "patterns": [
      "^Document exists$"
    ],
    "dsl": "$doc : Document()"
  },
  {
    "id": "DECL_TYPE",
    "patterns": [
      "^Declaration type oneof (.+)$",
      "^Declaration type must be one of (.+)$"
    ],
    "dsl": "$dec : Declaration( type in ({1}) ) from $doc.declarations",
    "requires": ["DOC"]
  },
  {
    "id": "AUTH_CODE",
    "patterns": [
      "^AuthorizationHolder\\.authorizationType\\.code must equal (.+)$"
    ],
    "dsl": "$auth : AuthorizationHolder( code == \"{1}\" ) from $doc.auths",
    "requires": ["DOC"]
  },
  {
    "id": "ITEM_TYPE",
    "patterns": [
      "^Item code must equal (.+)$"
    ],
    "dsl": "$item : Item( code == \"{1}\" ) from $dec.items",
    "requires": ["DECL_TYPE"]
  }
]
