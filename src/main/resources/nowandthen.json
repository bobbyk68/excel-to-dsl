{
  "FlagError": {
    "lines": [
      "results.addError(\"${code}\", \"${message}\");",
      "audit.log(\"rule=${ruleName}, code=${code}\");"
    ],
    "prepend": [
      "// THEN: starting ${ruleName}"
    ],
    "append": [
      "// THEN: ending ${ruleName}"
    ]
  }
}


{
  "BasicWhen": {
    "code": "${conditions}",
    "prepend": [
      "// WHEN: for ${ruleName} with types ${decTypesExpanded}"
    ]
  }
}